# ─── Notion (Request a Demo modal) ─────────────────────────────────────────
# Internal-integration secret with access to the SmilePass HUB page.
# Create at https://www.notion.so/profile/integrations (type: Internal).
# Then open the SmilePass HUB page → ⋯ → "Connections" → add this integration.
NOTION_API_KEY=ntn_xxxxxxxxxx

# UUID of the "Demo Requests" database that lives inside the SmilePass HUB.
# Current value (no dashes required): 00c05ce69a1e435da2bde4a6dcd04572
NOTION_DEMO_REQUESTS_DB_ID=00c05ce69a1e435da2bde4a6dcd04572

# UUID of the "Support Tickets" database inside the SmilePass HUB.
# Used by the wiki chatbot to escalate questions it can't answer.
NOTION_SUPPORT_TICKETS_DB_ID=165ff80c80324d20b4e9690842761fa7

# ─── Anthropic (Wiki chatbot) ──────────────────────────────────────────────
# Claude API key powering the chatbot on every /wiki/* page.
# Create one at https://console.anthropic.com/settings/keys (it starts with sk-ant-).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxx

# ─── Resend (Contact / newsletter — Phase 2) ───────────────────────────────
# Resend API key for transactional emails (contact form, newsletter).
# Get one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxx

# Verified from-domain for outbound email (must be verified in Resend dashboard)
RESEND_FROM_EMAIL=noreply@smilepass.com.au

# Where contact form submissions land
LEAD_DESTINATION_EMAIL=enquiries@smilepass.com.au

# ─── Analytics ─────────────────────────────────────────────────────────────
# Optional: Google Tag Manager container id (production marketing tracking)
NEXT_PUBLIC_GTM_ID=GTM-P8R4CGRX
